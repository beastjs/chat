module
  const clock = (seconds: number) => Math.floor(seconds / 60) + ':' + String(Math.floor(seconds % 60)).padStart(2, '0');
import { useEffect, useRef, useState } from 'octane'
import Icon from '../../../../src/lib/icons/Icon.btsx'

props { src, name }: { src: string; name: string }
setup
  const media = useRef<HTMLAudioElement | null>(null);
  const [failed, setFailed] = useState(false);
  const [playing, setPlaying] = useState(false);
  const [starting, setStarting] = useState(false);
  const [position, setPosition] = useState(0);
  const [duration, setDuration] = useState(0);
  const [error, setError] = useState('');
  const alive = useRef(true);
  useEffect(() => {
    alive.current = true;
    const node = media.current;
    return () => { alive.current = false; node?.pause(); };
  }, []);
  const updateDuration = () => {
    const value = media.current?.duration ?? 0;
    setDuration(Number.isFinite(value) && value > 0 ? value : 0);
  };
  const toggle = async () => {
    const node = media.current;
    if (!node || starting) return;
    setError('');
    if (!node.paused) { node.pause(); return; }
    setStarting(true);
    try { await node.play(); }
    catch { if (alive.current) setError('Could not play audio. Try again.'); }
    finally { if (alive.current) setStarting(false); }
  };

div.bc-audio-player(data-playing={playing})
  audio(ref={media} src={src} preload="metadata" aria-label={'Play ' + name} onLoadedMetadata={updateDuration} onDurationChange={updateDuration} onTimeUpdate={() => setPosition(media.current?.currentTime ?? 0)} onPlay={() => setPlaying(true)} onPause={() => setPlaying(false)} onEnded={() => { setPlaying(false); if (media.current) media.current.currentTime = 0; setPosition(0); }} onError={() => setFailed(true)})
  if failed
    p.bc-audio-error(role="status") Audio preview is unavailable in this browser.
  else
    fragment
      button.bc-audio-toggle(type="button" aria-label={(playing ? 'Pause ' : 'Play ') + name} disabled={starting} onClick={() => void toggle()})
        Icon(name={playing ? 'pause' : 'play'} size={18})
      div.bc-audio-timeline
        input.bc-audio-seek(type="range" min={0} max={duration || 1} step={0.1} value={Math.min(position, duration || 1)} disabled={!duration} aria-label="Seek audio" aria-valuetext={clock(position) + ' of ' + clock(duration)} style={{'--bc-audio-progress': (duration ? Math.min(position / duration, 1) * 100 : 0) + '%'}} onInput={event => { const value = Number(event.currentTarget.value); if (media.current) media.current.currentTime = value; setPosition(value); }})
        div.bc-audio-times
          span #{clock(position)}
          span #{duration ? clock(duration) : 'Audio'}
  if error
    p.bc-audio-error(role="status") #{error}
