import { useEffect, useState } from 'octane'
import { useMessages } from '../hooks'
import type { ChatAdapter, ChatIdentity } from '../core/adapter'
import Composer from './Composer.btsx'
import Bubble, { BubbleContent } from './ui/bubble.btsx'
import MessageScroller, { MessageScrollerProvider, MessageScrollerViewport, MessageScrollerContent, MessageScrollerItem, MessageScrollerButton, useMessageScroller } from './ui/message-scroller.btsx'

component ThreadBody
  props { adapter, identity, fid, pageSize }: { adapter: ChatAdapter; identity: ChatIdentity; fid: string; pageSize: number }
  setup
    const [limit, setLimit] = useState(pageSize);
    const { scrollToEnd, scrollToEndIfPinned } = useMessageScroller();
    const { data, loading, error, enteringId, entryMotion } = useMessages(adapter, fid, limit, identity.id, () => scrollToEndIfPinned({ behavior: 'instant' }));
    const [actionError, setActionError] = useState<string | null>(null);
    const lastUnread = data.messages.find(message => message.receiverId === identity.id && !message.readAt)?._id;
    useEffect(() => {
      if (!lastUnread || !adapter.markAsRead) return;
      let active = true;
      void adapter.markAsRead(fid).catch(cause => { if (active) setActionError(cause instanceof Error ? cause.message : 'Could not mark messages read'); });
      return () => { active = false; };
    }, [adapter, fid, lastUnread]);
    const react = async (id: string) => {
      try { await adapter.toggleLike?.(id); }
      catch (cause) { setActionError(cause instanceof Error ? cause.message : 'Could not update reaction'); }
    };
  div.bc-thread
    MessageScroller(className="bc-scroller")
      MessageScrollerViewport(className="bc-messages" preserveScrollOnPrepend={true})
        MessageScrollerContent
          if data.hasMore
            button.bc-load(type="button" onClick={() => setLimit(value => value + pageSize)}) Load earlier messages
          if loading
            p.bc-state(role="status") Loading messages…
          if error
            p.bc-error(role="alert") #{error}
          if !loading && !error && data.messages.length === 0
            p.bc-state No messages yet. Start the conversation.
          each message in data.messages key message._id
            MessageScrollerItem(messageId={message._id} data-entering={message._id === enteringId ? 'true' : undefined} data-entry-motion={message._id === enteringId ? entryMotion : undefined} style={message._id === enteringId && entryMotion === 'native' ? {viewTransitionName: 'bc-sent-message'} : undefined} className={message.senderId === identity.id ? 'bc-message bc-own' : 'bc-message bc-other'})
              Bubble(variant={message.senderId === identity.id ? 'default' : 'secondary'} align={message.senderId === identity.id ? 'end' : 'start'} className="bc-bubble")
                BubbleContent(className="bc-bubble-content")
                  p.bc-message-text #{message.content}
              each attachment in message.attachments ?? [] key attachment.storageId
                if attachment.url
                  a.bc-attachment(href={attachment.url} target="_blank" rel="noopener noreferrer") #{attachment.fileName}
              div.bc-message-meta
                time(datetime={message.createdAt}) #{message.createdAt.slice(11, 16)}
                if message.senderId === identity.id
                  span #{message.readAt ? 'Read' : 'Sent'}
                if adapter.toggleLike
                  button.bc-reaction(type="button" aria-label="Like message" aria-pressed={message.likes?.some(like => like.userId === identity.id) ?? false} onClick={() => void react(message._id)}) #{'♡ ' + (message.likes?.length || '')}
      MessageScrollerButton(className="bc-scroll-button")
    if actionError
      p.bc-error(role="alert") #{actionError}
    Composer(adapter={adapter} fid={fid} onSent={() => scrollToEnd({ behavior: 'instant' })})

props { adapter, identity, fid, pageSize = 50, smoothScroll = true }: { adapter: ChatAdapter; identity: ChatIdentity; fid: string; pageSize?: number; smoothScroll?: boolean }
MessageScrollerProvider(autoScroll={true} defaultScrollPosition="end" scrollEdgeThreshold={80} trackVisibility={false} smoothScroll={smoothScroll})
  ThreadBody(adapter={adapter} identity={identity} fid={fid} pageSize={pageSize})
