module
  interface PendingFile {
    id: string;
    file: File;
    preview: string | null;
    uploaded?: Attachment;
  }
import { useEffect, useId, useLayoutEffect, useRef, useState } from 'octane'
import type { ChatAdapter } from '../core/adapter'
import type { Attachment } from '../core/types'
import { formatFileSize, isAudioAttachment } from '../core/attachment'
import AudioPlayer from './AudioPlayer.btsx'
import AudioRecorder from './AudioRecorder.btsx'
import Icon from "../../../../src/lib/icons/Icon.btsx";

props { adapter, fid, onSent }: { adapter: ChatAdapter; fid: string; onSent?: () => void }
setup
  const [draft, setDraft, getDraft] = useState('');
  const [files, setFiles, getFiles] = useState<PendingFile[]>([]);
  const [uploadingId, setUploadingId] = useState<string | null>(null);
  const picker = useRef<HTMLInputElement | null>(null);
  const [optionsOpen, setOptionsOpen] = useState(false);
  const [recording, setRecording, getRecording] = useState(false);
  const optionsId = useId();
  const options = useRef<HTMLDivElement | null>(null);
  const optionsButton = useRef<HTMLButtonElement | null>(null);
  useEffect(() => {
    if (!optionsOpen) return;
    options.current?.querySelector<HTMLButtonElement>('.bc-attachment-options button')?.focus();
    const dismiss = (event: PointerEvent) => {
      if (!options.current?.contains(event.target as Node)) setOptionsOpen(false);
    };
    document.addEventListener('pointerdown', dismiss);
    return () => document.removeEventListener('pointerdown', dismiss);
  }, [optionsOpen]);
  const previewUrls = useRef(new Set<string>());
  const uploadAbort = useRef<AbortController | null>(null);
  const [sending, setSending] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const input = useRef<HTMLTextAreaElement | null>(null);
  useLayoutEffect(() => {
    const node = input.current;
    if (!node) return;
    node.style.height = 'auto';
    node.style.height = Math.min(node.scrollHeight || 24, 120) + 'px';
  }, [draft]);
  const busy = useRef(false);
  const alive = useRef(true);
  useEffect(() => {
    alive.current = true;
    return () => {
      alive.current = false;
      uploadAbort.current?.abort();
      for (const url of previewUrls.current) URL.revokeObjectURL(url);
      previewUrls.current.clear();
    };
  }, []);
  const releasePreview = (item: PendingFile) => {
    if (!item.preview) return;
    URL.revokeObjectURL(item.preview);
    previewUrls.current.delete(item.preview);
  };
  const addFiles = (selectedFiles: File[]) => {
    if (busy.current) return;
    const selected = selectedFiles.map(file => {
      const preview = file.type.startsWith('image/') || isAudioAttachment({fileType: file.type, fileName: file.name}) ? URL.createObjectURL(file) : null;
      if (preview) previewUrls.current.add(preview);
      return { id: crypto.randomUUID(), file, preview };
    });
    setFiles(current => [...current, ...selected]);
    setError(null);
    input.current?.focus({ preventScroll: true });
  };
  const selectFiles = (event: Event & { currentTarget: HTMLInputElement }) => {
    addFiles(Array.from(event.currentTarget.files ?? []));
    event.currentTarget.value = '';
  };
  const finishRecording = (file?: File) => {
    setRecording(false);
    if (file) addFiles([file]);
    optionsButton.current?.focus();
  };
  const removeFile = (id: string) => {
    if (busy.current) return;
    const item = getFiles().find(item => item.id === id);
    if (item) releasePreview(item);
    setFiles(current => current.filter(item => item.id !== id));
    setError(null);
  };
  const send = async () => {
    const content = getDraft().trim();
    const selected = getFiles();
    if ((!content && !selected.length) || busy.current || getRecording()) return;
    setOptionsOpen(false);
    busy.current = true;
    setSending(true);
    setError(null);
    const controller = new AbortController();
    uploadAbort.current = controller;
    try {
      const attachments: Attachment[] = [];
      for (const item of selected) {
        let attachment = item.uploaded;
        if (!attachment) {
          if (!adapter.upload) throw new Error('This chat does not support uploads');
          setUploadingId(item.id);
          attachment = await adapter.upload(item.file, controller.signal);
          if (!alive.current || controller.signal.aborted) return;
          setFiles(current => current.map(file => file.id === item.id ? { ...file, uploaded: attachment } : file));
        }
        attachments.push(attachment);
      }
      if (!alive.current || controller.signal.aborted) return;
      setUploadingId(null);
      await adapter.sendMessage(fid, content, attachments.length ? attachments : undefined);
      if (!alive.current) return;
      setDraft(current => current.trim() === content ? '' : current);
      const sentIds = new Set(selected.map(item => item.id));
      setFiles(current => current.filter(item => !sentIds.has(item.id)));
      for (const item of selected) releasePreview(item);
      onSent?.();
      input.current?.focus({ preventScroll: true });
    } catch (cause) {
      if (alive.current) setError(cause instanceof Error ? cause.message : 'Message failed to send');
    } finally {
      busy.current = false;
      uploadAbort.current = null;
      if (alive.current) { setSending(false); setUploadingId(null); }
    }
  };

form.bc-composer(onSubmit={event => { event.preventDefault(); void send(); }})
  if recording
    AudioRecorder(onReady={file => finishRecording(file)} onCancel={() => finishRecording()})
  if files.length > 0
    ul.bc-pending-files(aria-label="Selected attachments")
      each item in files key item.id
        li.bc-pending-file(data-audio={isAudioAttachment({fileType: item.file.type, fileName: item.file.name})})
          if item.preview && isAudioAttachment({fileType: item.file.type, fileName: item.file.name})
            fragment
              AudioPlayer(src={item.preview} name="Voice message")
              if uploadingId === item.id
                span.bc-audio-upload(role="status") Uploading…
          elseif item.preview
            img.bc-file-preview(src={item.preview} alt={item.file.name})
          else
            span.bc-file-icon(aria-hidden="true")
              Icon(name="file")
          if !isAudioAttachment({fileType: item.file.type, fileName: item.file.name})
            div.bc-file-info
              strong #{item.file.name}
              span(role={uploadingId === item.id ? 'status' : undefined}) #{uploadingId === item.id ? 'Uploading…' : formatFileSize(item.file.size)}
          button.bc-remove-file(type="button" aria-label={'Remove ' + item.file.name} disabled={sending} onClick={() => removeFile(item.id)})
            Icon(name="close")
  if adapter.upload
    fragment
      input.bc-file-picker(ref={picker} type="file" multiple hidden onChange={selectFiles})
      div.bc-attachment-actions(ref={options} onKeyDown={event => { if (event.key === 'Escape') { setOptionsOpen(false); optionsButton.current?.focus(); } }} onBlur={event => { if (!event.currentTarget.contains(event.relatedTarget as Node | null)) setOptionsOpen(false); }})
        button.bc-attach(ref={optionsButton} type="button" aria-label="Add attachments" aria-expanded={optionsOpen} aria-controls={optionsId} disabled={sending || recording} onClick={() => setOptionsOpen(open => !open)})
          Icon(name="plus")
        if optionsOpen
          div.bc-attachment-options(id={optionsId} role="group" aria-label="Attachment options")
            button(type="button" onClick={() => { setOptionsOpen(false); picker.current!.accept = 'image/*,video/*'; picker.current?.click(); }})
              Icon(name="image")
              span Photos and videos
            button(type="button" onClick={() => { setOptionsOpen(false); picker.current!.accept = ''; picker.current?.click(); }})
              Icon(name="file")
              span Attach files
            button(type="button" onClick={() => { setOptionsOpen(false); setRecording(true); setError(null); }})
              Icon(name="audio")
              span Record audio
  div.bc-composer-field
    textarea(ref={input} rows={1} aria-label="Message" placeholder="Message…" autoComplete="off" enterKeyHint="send" value={draft} onInput={event => setDraft(event.currentTarget.value)} onKeyDown={event => { if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) { event.preventDefault(); void send(); } }})
  button.bc-send(type="submit" aria-label={sending ? 'Sending message' : 'Send message'} onPointerDown={event => event.preventDefault()} disabled={sending || recording || (!draft.trim() && !files.length)})
    Icon(name="arrow-up")
    span #{uploadingId ? 'Uploading' : sending ? 'Sending' : 'Send'}
  if error
    p.bc-error(role="alert") #{error}
